---
interface Props {
  label: string;
  id?: string;
}
const { label, id } = Astro.props;
const slug = label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const headingId = `${id ?? slug}-heading`;
---

<section id={id} class="panel" aria-labelledby={headingId}>
  <h2 id={headingId} class="panel-label">{label}</h2>
  <slot />
</section>

<style>
  .panel {
    position: relative;
    min-width: 0;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .panel-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  @media (max-width: 520px) {
    .panel {
      padding: 20px;
    }
  }
</style>
