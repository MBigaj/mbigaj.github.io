---
// One full-screen viewer for every `a.shot` thumbnail on the page. Renders the dialog only;
// the thumbnails are links to the large image, which is the fallback without JavaScript.
---

<dialog class="viewer" aria-label="Screenshot viewer" data-screen-viewer>
  <div class="viewer-stage">
    <img class="viewer-img" alt="" />
    <p class="viewer-caption"></p>
    <p class="viewer-count" aria-live="polite"></p>
  </div>
  <button type="button" class="viewer-btn viewer-close" aria-label="Close">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
  </button>
  <button type="button" class="viewer-btn viewer-prev" aria-label="Previous screenshot">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
  </button>
  <button type="button" class="viewer-btn viewer-next" aria-label="Next screenshot">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
  </button>
</dialog>

<style>
  .viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    overflow: hidden;
    opacity: 0;
    transition: opacity 200ms ease, display 200ms allow-discrete, overlay 200ms allow-discrete;
  }
  .viewer[open] {
    opacity: 1;
  }
  .viewer[data-closing] {
    opacity: 0;
  }
  .viewer::backdrop {
    background: color-mix(in srgb, var(--ground) 90%, transparent);
    opacity: 0;
    transition: opacity 200ms ease, display 200ms allow-discrete, overlay 200ms allow-discrete;
  }
  .viewer[open]::backdrop {
    opacity: 1;
  }
  .viewer[data-closing]::backdrop {
    opacity: 0;
  }
  @starting-style {
    .viewer[open] {
      opacity: 0;
    }
    .viewer[open]::backdrop {
      opacity: 0;
    }
  }
  .viewer-stage {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 64px 72px;
  }
  .viewer-img {
    display: block;
    max-width: 100%;
    /* Room for the caption, the counter and the padding above and below. */
    max-height: calc(100dvh - 190px);
    object-fit: contain;
    border: 1px solid var(--border);
    border-radius: 4px;
    touch-action: pan-y;
    transform: scale(0.98);
    transition: transform 200ms ease;
  }
  .viewer[open] .viewer-img {
    transform: none;
  }
  .viewer[data-closing] .viewer-img {
    transform: scale(0.98);
  }
  @starting-style {
    .viewer[open] .viewer-img {
      transform: scale(0.98);
    }
  }
  .viewer-caption {
    margin: 0;
    max-width: min(100%, 880px);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-2);
  }
  .viewer-count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .viewer-btn {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid var(--btn-border);
    border-radius: 4px;
    background: var(--panel);
    color: var(--text);
    cursor: pointer;
  }
  .viewer-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .viewer-btn[hidden] {
    display: none;
  }
  .viewer-close {
    top: 12px;
    right: 12px;
  }
  .viewer-prev,
  .viewer-next {
    top: 50%;
    margin-top: -24px;
  }
  .viewer-prev {
    left: 12px;
  }
  .viewer-next {
    right: 12px;
  }
  @media (max-width: 520px) {
    .viewer-stage {
      padding: 64px 12px 72px;
    }
    .viewer-prev,
    .viewer-next {
      top: auto;
      bottom: 12px;
      margin-top: 0;
    }
    .viewer-prev {
      left: 12px;
    }
    .viewer-next {
      right: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .viewer,
    .viewer::backdrop,
    .viewer-img {
      transition: none;
    }
  }
</style>

<script>
  const FADE_MS = 200;

  for (const dialog of document.querySelectorAll<HTMLDialogElement>('[data-screen-viewer]')) setUp(dialog);

  function setUp(dialog: HTMLDialogElement) {
    if (dialog.dataset.ready) return;
    dialog.dataset.ready = 'true';

    const thumbs = [...document.querySelectorAll<HTMLAnchorElement>('a.shot')];
    if (thumbs.length === 0) return;

    const img = dialog.querySelector<HTMLImageElement>('.viewer-img')!;
    const caption = dialog.querySelector<HTMLElement>('.viewer-caption')!;
    const count = dialog.querySelector<HTMLElement>('.viewer-count')!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>('.viewer-close')!;
    const prevBtn = dialog.querySelector<HTMLButtonElement>('.viewer-prev')!;
    const nextBtn = dialog.querySelector<HTMLButtonElement>('.viewer-next')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const root = document.documentElement;

    let index = 0;
    let loadToken = 0;
    let closeTimer = 0;

    function show(i: number) {
      index = i;
      const thumb = thumbs[i]!;
      const thumbImg = thumb.querySelector('img')!;
      const token = ++loadToken;
      img.alt = thumbImg.alt;
      caption.textContent = thumb.closest('figure')?.querySelector('figcaption')?.textContent ?? '';
      count.textContent = `${i + 1} / ${thumbs.length}`;
      // The thumbnail is already loaded: show it scaled up until the large image arrives.
      img.src = thumbImg.currentSrc || thumbImg.src;
      const large = new Image();
      large.onload = () => {
        if (token === loadToken) img.src = large.src;
      };
      large.src = thumb.href;

      const focusLost = (prevBtn.contains(document.activeElement) && i === 0) || (nextBtn.contains(document.activeElement) && i === thumbs.length - 1);
      prevBtn.hidden = i === 0;
      nextBtn.hidden = i === thumbs.length - 1;
      if (focusLost) closeBtn.focus();
    }

    function step(by: number) {
      const next = index + by;
      if (next >= 0 && next < thumbs.length) show(next);
    }

    function open(i: number) {
      window.clearTimeout(closeTimer);
      dialog.removeAttribute('data-closing');
      show(i);
      root.style.overflow = 'hidden';
      if (!dialog.open) dialog.showModal();
      closeBtn.focus();
    }

    function close() {
      if (!dialog.open || dialog.hasAttribute('data-closing')) return;
      if (reduced.matches) return dialog.close();
      dialog.setAttribute('data-closing', '');
      closeTimer = window.setTimeout(() => dialog.close(), FADE_MS);
    }

    dialog.addEventListener('close', () => {
      loadToken++;
      dialog.removeAttribute('data-closing');
      root.style.overflow = '';
      img.removeAttribute('src');
      thumbs[index]!.focus();
    });
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });

    thumbs.forEach((thumb, i) =>
      thumb.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        open(i);
      }),
    );
    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', () => step(-1));
    nextBtn.addEventListener('click', () => step(1));
    dialog.addEventListener('click', (e) => {
      // Only the empty area counts as the backdrop; the image, caption and buttons are children.
      if (e.target === dialog || (e.target as HTMLElement).classList.contains('viewer-stage')) close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') step(-1);
      else if (e.key === 'ArrowRight') step(1);
    });

    let startX = 0;
    let startY = 0;
    let tracking = false;
    img.addEventListener('pointerdown', (e) => {
      tracking = e.pointerType === 'touch';
      startX = e.clientX;
      startY = e.clientY;
    });
    img.addEventListener('pointerup', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(e.clientY - startY)) step(dx < 0 ? 1 : -1);
    });
    img.addEventListener('pointercancel', () => {
      tracking = false;
    });
  }
</script>
