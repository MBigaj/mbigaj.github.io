---
import Panel from '../Panel.astro';

interface Entry {
  code: string;
  employer: string;
  title: string;
  summary: string;
  tags: string[];
}
interface Props {
  entries: Entry[];
}
const { entries } = Astro.props;
---

<Panel label="04 / PRODUCTION WORK" id="work">
  <div class="entries">
    {
      entries.map((e) => (
        <div class="entry">
          <div class="code">{e.code} · {e.employer}</div>
          <div class="title">{e.title}</div>
          <div class="summary">{e.summary}</div>
          <div class="tags">{e.tags.join(' · ')}</div>
        </div>
      ))
    }
  </div>
  <a class="all" href="/work/">all work →</a>
</Panel>

<style>
  .entries {
    display: flex;
    flex-direction: column;
  }
  .entry {
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .entry:first-child {
    padding-top: 0;
  }
  .entry:last-child {
    border-bottom: 0;
    padding-bottom: 4px;
  }
  .code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .title {
    font-size: 17px;
    font-weight: 600;
  }
  .summary {
    font-size: 15px;
    color: var(--text-2);
  }
  .tags {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .all {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 13px;
  }
</style>
