---
import Panel from '../Panel.astro';
import { SITE } from '../../lib/site';

interface Props {
  now: string;
  since: string;
  degree: string;
}
const { now, since, degree } = Astro.props;
---

<Panel label="01 / STATUS" id="identity">
  <div class="facts">
    <div><div class="fact-label">NOW</div><div class="fact-value">{now}</div></div>
    <div><div class="fact-label">IN ENGINEERING SINCE</div><div class="fact-value">{since}</div></div>
    <div><div class="fact-label">DEGREE</div><div class="fact-value">{degree}</div></div>
  </div>
  <div class="identity-links">
    <a class="ghost" href={`mailto:${SITE.email}`}>Email</a>
    <a class="solid" href={SITE.cv}>Download CV</a>
  </div>
</Panel>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    padding: 16px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .fact-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .fact-value {
    font-size: 15px;
  }
  .identity-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .identity-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 4px;
  }
  .ghost {
    border: 1px solid var(--btn-border);
  }
  .solid {
    background: var(--text);
    color: var(--ground);
    font-weight: 600;
  }
  .solid:hover {
    color: var(--ground);
    background: var(--accent);
  }
</style>
