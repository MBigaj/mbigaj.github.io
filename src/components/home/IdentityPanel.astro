---
import Panel from '../Panel.astro';
import { SITE } from '../../lib/site';

interface Props {
  now: string;
  since: string;
  degree: string;
}
const { now, since, degree } = Astro.props;
---

<Panel label="01 / STATUS" id="identity">
  <div class="facts">
    <div><div class="fact-label">NOW</div><div class="fact-value">{now}</div></div>
    <div><div class="fact-label">IN ENGINEERING SINCE</div><div class="fact-value">{since}</div></div>
    <div><div class="fact-label">DEGREE</div><div class="fact-value">{degree}</div></div>
  </div>
  <div class="identity-links">
    <span class="email" data-email>{SITE.email}</span>
    <button class="copy" type="button" aria-label="Copy email address" hidden>Copy</button>
    <span class="sr-only" role="status" data-copy-status></span>
    <a class="solid" href={SITE.cv}>Download CV</a>
  </div>
</Panel>

<script>
  const RESET_MS = 2000;
  for (const panel of document.querySelectorAll<HTMLElement>('#identity')) {
    const address = panel.querySelector<HTMLElement>('[data-email]');
    const button = panel.querySelector<HTMLButtonElement>('button.copy');
    const status = panel.querySelector<HTMLElement>('[data-copy-status]');
    if (!address || !button || !status || button.dataset.ready) continue;
    button.dataset.ready = 'true';
    button.hidden = false;
    let timer: number | undefined;
    let announce: number | undefined;

    const select = () => {
      const range = document.createRange();
      range.selectNodeContents(address);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
    };

    const say = (text: string) => {
      window.clearTimeout(timer);
      window.clearTimeout(announce);
      status.textContent = '';
      // Blank first, then set, so a repeat press is announced again.
      announce = window.setTimeout(() => {
        status.textContent = text;
      }, 50);
      timer = window.setTimeout(() => {
        button.textContent = 'Copy';
        status.textContent = '';
      }, RESET_MS);
    };

    button.addEventListener('click', async () => {
      try {
        if (!navigator.clipboard) throw new Error('no clipboard');
        await navigator.clipboard.writeText(address.textContent?.trim() ?? '');
        button.textContent = 'Copied';
        say('Email address copied');
      } catch {
        select();
        say('Press Ctrl+C to copy');
      }
    });
  }
</script>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    padding: 16px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .fact-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .fact-value {
    font-size: 15px;
  }
  .identity-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .identity-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 4px;
  }
  .email,
  .copy {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--btn-border);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .email {
    user-select: all;
    overflow-wrap: anywhere;
  }
  .copy {
    background: none;
    color: var(--text);
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .copy[hidden] {
    display: none;
  }
  .solid {
    background: var(--text);
    color: var(--ground);
    font-weight: 600;
  }
  .solid:hover {
    color: var(--ground);
    background: var(--accent);
  }
</style>
