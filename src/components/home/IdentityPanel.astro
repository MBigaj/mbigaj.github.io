---
import Panel from '../Panel.astro';
import { SITE } from '../../lib/site';

interface Props {
  now: string;
  since: string;
  degree: string;
}
const { now, since, degree } = Astro.props;
---

<Panel label="01 / STATUS" id="identity">
  <div class="facts">
    <div><div class="fact-label">NOW</div><div class="fact-value">{now}</div></div>
    <div><div class="fact-label">IN ENGINEERING SINCE</div><div class="fact-value">{since}</div></div>
    <div><div class="fact-label">DEGREE</div><div class="fact-value">{degree}</div></div>
  </div>
  <div class="identity-links">
    <div class="email-row">
      <span class="email" data-email>{SITE.email}</span>
      <button class="copy" type="button" aria-label="Copy email address" title="Copy email address" data-state="idle" hidden>
        <svg class="icon icon-copy" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="12" height="12" rx="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
        <svg class="icon icon-check" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6 9 17l-5-5" />
        </svg>
      </button>
      <span class="sr-only" role="status" data-copy-status></span>
    </div>
    <a class="solid" href={SITE.cv}>Download CV</a>
  </div>
</Panel>

<script>
  const RESET_MS = 2000;
  for (const panel of document.querySelectorAll<HTMLElement>('#identity')) {
    const address = panel.querySelector<HTMLElement>('[data-email]');
    const button = panel.querySelector<HTMLButtonElement>('button.copy');
    const status = panel.querySelector<HTMLElement>('[data-copy-status]');
    if (!address || !button || !status || button.dataset.ready) continue;
    button.dataset.ready = 'true';
    button.hidden = false;
    let timer: number | undefined;
    let announce: number | undefined;

    const select = () => {
      const range = document.createRange();
      range.selectNodeContents(address);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
    };

    const say = (text: string) => {
      window.clearTimeout(timer);
      window.clearTimeout(announce);
      status.textContent = '';
      // Blank first, then set, so a repeat press is announced again.
      announce = window.setTimeout(() => {
        status.textContent = text;
      }, 50);
      timer = window.setTimeout(() => {
        button.dataset.state = 'idle';
        status.textContent = '';
      }, RESET_MS);
    };

    button.addEventListener('click', async () => {
      try {
        if (!navigator.clipboard) throw new Error('no clipboard');
        await navigator.clipboard.writeText(address.textContent?.trim() ?? '');
        button.dataset.state = 'copied';
        say('Email address copied');
      } catch {
        select();
        say('Press Ctrl+C to copy');
      }
    });
  }
</script>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    padding: 16px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .fact-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .fact-value {
    font-size: 15px;
  }
  .identity-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .email-row {
    display: flex;
    align-items: stretch;
    max-width: 100%;
  }
  .identity-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 4px;
  }
  .email,
  .copy {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border: 1px solid var(--btn-border);
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .email {
    padding: 0 16px;
    border-radius: 4px 0 0 4px;
    user-select: all;
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .copy {
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    padding: 0;
    margin-left: -1px;
    border-radius: 0 4px 4px 0;
    background: none;
    color: var(--text);
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .copy[hidden] {
    display: none;
  }
  .icon {
    display: block;
  }
  .copy[data-state='idle'] .icon-check,
  .copy[data-state='copied'] .icon-copy {
    display: none;
  }
  .copy:focus-visible {
    position: relative;
  }
  .solid {
    background: var(--text);
    color: var(--ground);
    font-weight: 600;
  }
  .solid:hover {
    color: var(--ground);
    background: var(--accent);
  }
</style>
