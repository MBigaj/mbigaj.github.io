---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import IdentityPanel from '../components/home/IdentityPanel.astro';
import TimelinePanel from '../components/home/TimelinePanel.astro';
import ProjectsPanel from '../components/home/ProjectsPanel.astro';
import WorkPanel from '../components/home/WorkPanel.astro';
import SkillMapPanel from '../components/home/SkillMapPanel.astro';
import { SITE } from '../lib/site';

const now = new Date().toISOString().slice(0, 7);

const skills = (await getCollection('skills')).map((s) => s.data);
const roles = (await getCollection('roles')).map((r) => r.data);

const current = roles.find((r) => r.kind === 'role' && r.end === null);
const education = roles.find((r) => r.kind === 'education');
if (!current) {
  throw new Error('Home page: no role in src/data/roles.json has "end": null, so there is no current role to show under NOW');
}
if (!education) {
  throw new Error('Home page: src/data/roles.json has no entry with "kind": "education" to show under DEGREE');
}
const degree = education.end ? `${education.title}, ${education.end.slice(0, 4)}` : education.title;
const since = String(Math.min(...roles.filter((r) => r.kind === 'role').map((r) => Number(r.start.slice(0, 4)))));

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    summary: p.data.summary,
    status: p.data.status,
    stack: p.data.stack.join(' · '),
  }));

const work = (await getCollection('work'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((w) => w.data);
---

<Base
  title={`${SITE.name} · ${SITE.role}`}
  description="Portfolio of Mikołaj Bigaj, a Python backend engineer building APIs, data stores, CI/CD pipelines and Kubernetes deployments."
>
  <div class="pair">
    <IdentityPanel
      now={`${current.title}, ${current.employer}`}
      since={since}
      degree={degree}
    />
    <TimelinePanel items={roles} {now} />
  </div>
  <div class="pair">
    <ProjectsPanel projects={projects} />
    <WorkPanel entries={work} />
  </div>
  <SkillMapPanel skills={skills} />
</Base>
