---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SkillMap from '../components/SkillMap';
import { loadEvidence } from '../lib/load-evidence';
import { AREAS, SITE } from '../lib/site';

const skills = (await getCollection('skills')).map((s) => s.data);
const evidence = await loadEvidence();
const areas = AREAS.map((a) => ({ id: a.id, label: a.label }));
---

<Base
  title={`Skills · ${SITE.name}`}
  description="Every skill, how often it is used, and the projects, work and roles where it was used."
>
  <a class="back" href="/">← control room</a>
  <h1 class="page-title">Skills</h1>
  <SkillMap client:load skills={skills} areas={areas} evidence={evidence} />
</Base>
