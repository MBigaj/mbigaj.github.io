---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
---

<Base title={`Not found · ${SITE.name}`} description="This page does not exist." noindex>
  <h1 class="page-title">Signal lost</h1>
  <p class="line">That page is not on the board.</p>
  <a class="back" href="/">Back to the control room</a>
</Base>

<style>
  .line {
    margin: 0;
    color: var(--text-2);
  }
</style>
