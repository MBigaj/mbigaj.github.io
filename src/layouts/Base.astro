---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** For pages with no address of their own, such as the 404 page: no canonical link, and kept out of search indexes. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const here = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  { label: 'Projects', href: '/#projects' },
  { label: 'Work', href: '/work/' },
  { label: 'Skills', href: '/skills/' },
  { label: 'CV', href: SITE.cv },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <header class="topbar">
        <a class="brand" href="/">
          <span class="dot" aria-hidden="true"></span>
          <span>mikołaj bigaj / portfolio</span>
        </a>
        <nav aria-label="Primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={item.href.replace(/\/$/, '') === here ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="footer">
        <span>Built with Astro and React, deployed to GitHub Pages.</span>
        <a href={`${SITE.github}/mbigaj.github.io`}>Source on GitHub</a>
      </footer>
    </div>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    background: var(--panel);
    font-family: var(--font-mono);
    font-size: 14px;
    transform: translateY(-200%);
  }
  .skip:focus {
    transform: none;
  }
  .shell {
    max-width: 1360px;
    margin: 0 auto;
    padding: 16px 24px 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  main {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 4px 0;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--text-2);
  }
  .dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--st-shipped);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
  }
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    text-decoration: underline;
  }
  .footer a:hover {
    color: var(--accent);
  }
</style>
